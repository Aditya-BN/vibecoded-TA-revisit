  {
    "id": "dash_css",
    "type": "ui-template",
    "z": "dash_tab",
    "group": "",
    "page": "",
    "ui": "dash_base",
    "name": "agrisoil CSS",
    "order": 0,
    "width": 0,
    "height": 0,
    "head": "",
    "format": "\n.agri-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 14px; width: 100%; }\n.agri-card { display: block; border: 1px solid #e1e6dd; border-radius: 14px; padding: 14px; text-decoration: none; color: #1d2a1f; background: #fff; }\n.agri-card:hover { box-shadow: 0 6px 18px rgba(0,0,0,.08); }\n.agri-card.off { opacity: .7; }\n.agri-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; }\n.agri-head b { font-size: 1.05rem; }\n.agri-id { color: #6b766d; font-size: .8rem; font-family: monospace; }\n.agri-pill { margin-left: auto; font-size: .75rem; font-weight: 600; padding: 2px 9px; border-radius: 99px; white-space: nowrap; }\n.agri-pill.on { background: #e3f2e1; color: #2f7d32; }\n.agri-pill.offl { background: #fbe4e2; color: #b3261e; }\n.agri-pill.warn { background: #fff1d6; color: #8a5a00; margin-left: 4px; }\n.agri-vals { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }\n.agri-v { background: #f4f6f1; border-radius: 10px; padding: 8px 4px; text-align: center; min-width: 0; }\n.agri-v .l { font-size: .7rem; color: #6b766d; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.agri-v .n { font-size: 1.05rem; font-weight: 650; font-variant-numeric: tabular-nums; white-space: nowrap; }\n.agri-v small { font-size: .65rem; color: #6b766d; font-weight: 500; }\n.agri-foot { margin-top: 10px; font-size: .8rem; color: #6b766d; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; }\n.agri-empty { color: #6b766d; padding: 24px; text-align: center; border: 1px dashed #e1e6dd; border-radius: 14px; }\n.agri-big .agri-vals { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; }\n.agri-big .agri-v { background: #fff; border: 1px solid #e1e6dd; padding: 12px; }\n.agri-big .agri-v .l { font-size: .8rem; }\n.agri-big .agri-v .n { font-size: 1.5rem; }\n.agri-meta { display: flex; gap: 18px; flex-wrap: wrap; color: #6b766d; font-size: .85rem; margin-top: 10px; }\n.agri-table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }\n.agri-table th, .agri-table td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #e1e6dd; font-size: .9rem; }\n.agri-table th { color: #6b766d; font-weight: 500; }\n.agri-note { color: #6b766d; font-size: .8rem; margin-top: 8px; }\n@media (max-width: 520px) { .agri-vals { grid-template-columns: repeat(3, 1fr); } }\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "site:style",
    "className": "",
    "x": 150,
    "y": 40,
    "wires": [
      []
    ]
