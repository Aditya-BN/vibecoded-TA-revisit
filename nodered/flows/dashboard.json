  {
    "id": "dash_lt_pg",
    "type": "postgresql",
    "z": "dash_tab",
    "name": "latest reading",
    "query": "SELECT d.id, COALESCE(NULLIF(d.name, ''), d.id) AS name, d.first_seen, d.last_seen, d.last_lat, d.last_lng,\n       r.ts, r.n, r.p, r.k, r.ph, r.moist, r.npk1_raw, r.npk2_raw, r.moist_raw, r.ph_raw, r.in_soil,\n       (now() - d.last_seen) < make_interval(secs => $1::int) AS online, now() AS server_now\nFROM devices d\nLEFT JOIN LATERAL (SELECT * FROM readings WHERE device_id = d.id ORDER BY ts DESC LIMIT 1) r ON true WHERE d.id = $2",
    "postgreSQLConfig": "ingest_pgconf",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 720,
    "y": 220,
    "wires": [
      [
        "dash_hist_params"
      ]
    ]
  },
  {
    "id": "dash_hist_params",
    "type": "function",
    "z": "dash_tab",
    "name": "range -> bucket",
    "func": "// 1 h / 24 h / 7 d, bucketed in SQL so every chart stays at a few hundred points\nconst RANGES = { '1h': ['1 hour', '10 seconds'], '24h': ['24 hours', '2 minutes'], '7d': ['7 days', '15 minutes'] };\nmsg.latest = Array.isArray(msg.payload) ? msg.payload[0] : null;\nconst [win, bucket] = RANGES[msg.range] || RANGES['24h'];\nmsg.params = [msg.device, bucket, win];\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 280,
    "wires": [
      [
        "dash_hist_pg"
      ]
    ]
  },
  {
    "id": "dash_hist_pg",
    "type": "postgresql",
    "z": "dash_tab",
    "name": "history (bucketed)",
    "query": "SELECT date_bin($2::interval, ts, timestamptz '2000-01-01') AS t,\n       avg(n)::real AS n, avg(p)::real AS p, avg(k)::real AS k, avg(ph)::real AS ph, avg(moist)::real AS moist,\n       avg(npk1_raw)::real AS npk1_raw, avg(npk2_raw)::real AS npk2_raw,\n       avg(moist_raw)::real AS moist_raw, avg(ph_raw)::real AS ph_raw\nFROM readings\nWHERE device_id = $1 AND ts >= now() - $3::interval\nGROUP BY 1 ORDER BY 1",
    "postgreSQLConfig": "ingest_pgconf",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 740,
    "y": 280,
    "wires": [
      [
        "dash_widgets"
      ]
    ]
  },
  {
    "id": "dash_widgets",
    "type": "function",
    "z": "dash_tab",
    "name": "to widgets (this viewer only)",
    "func": "// One client's sensor page: latest values, the five charts (same rows, each chart picks its key)\n// and the raw ADC table. Every message carries msg._client, so only that viewer gets it.\nconst c = msg._client;\nconst rows = Array.isArray(msg.payload) ? msg.payload : [];\nconst points = rows.map(r => ({ ...r, t: new Date(r.t).getTime() }));\n\nconst latest = msg.latest\n    ? { payload: msg.latest, _client: c }\n    : { payload: null, missing: msg.device, _client: c };\n\nconst charts = { payload: points, action: 'replace', _client: c };\nif (!points.length) charts.payload = []; // clears the chart\n\nconst stats = {};\nfor (const k of ['npk1_raw', 'npk2_raw', 'moist_raw', 'ph_raw']) {\n    const v = rows.map(r => r[k]).filter(x => x !== null);\n    if (v.length) stats[k] = { min: Math.min(...v), max: Math.max(...v), avg: v.reduce((a, b) => a + b, 0) / v.length };\n}\nconst raw = { payload: { latest: msg.latest || {}, stats }, range: msg.range, _client: c };\nreturn [latest, charts, raw];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 360,
    "wires": [
      [
        "dash_latest"
      ],
      [
        "dash_c_n",
        "dash_c_p",
        "dash_c_k",
        "dash_c_ph",
        "dash_c_moist"
      ],
      [
        "dash_raw"
      ]
    ]
  },
  {
    "id": "dash_latest",
    "type": "ui-template",
    "z": "dash_tab",
    "group": "dash_g_latest",
    "page": "",
    "ui": "",
    "name": "latest values",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div class=\"agri-big\" style=\"width: 100%\">\n    <div v-if=\"!d\" class=\"agri-empty\">{{ msg?.missing ? 'Sensor \"' + msg.missing + '\" belum pernah kirim data.' : 'Pilih sensor.' }}</div>\n    <template v-else>\n      <div class=\"agri-head\">\n        <b>{{ d.name }}</b><span v-if=\"d.name !== d.id\" class=\"agri-id\">{{ d.id }}</span>\n        <span class=\"agri-pill\" :class=\"d.online ? 'on' : 'offl'\" style=\"margin-left: 8px\">\u25cf {{ d.online ? 'online' : 'offline' }}</span>\n        <span v-if=\"d.in_soil === false\" class=\"agri-pill warn\">tidak di tanah</span>\n      </div>\n      <div class=\"agri-vals\">\n        <div v-for=\"f in fields\" :key=\"f.k\" class=\"agri-v\">\n          <div class=\"l\">{{ f.l }}</div><div class=\"n\">{{ fmt(d[f.k], f.d) }} <small>{{ f.u }}</small></div>\n        </div>\n      </div>\n      <div class=\"agri-meta\">\n        <span>Bacaan terakhir: <b>{{ wib(d.ts) }}</b></span>\n        <span>Terakhir terlihat: <b>{{ ago(d.last_seen) }}</b></span>\n        <span>Pertama terlihat: {{ wib(d.first_seen) }}</span>\n        <span v-if=\"d.last_lat !== null\">Lokasi: {{ d.last_lat.toFixed(6) }}, {{ d.last_lng.toFixed(6) }}</span>\n      </div>\n    </template>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() { return { fields: [\n        { k: 'n', s: 'N', l: 'Nitrogen (N)', u: 'ppm', d: 1 },\n        { k: 'p', s: 'P', l: 'Fosfor (P)', u: 'ppm', d: 1 },\n        { k: 'k', s: 'K', l: 'Kalium (K)', u: 'ppm', d: 1 },\n        { k: 'ph', s: 'pH', l: 'pH tanah', u: 'pH', d: 2 },\n        { k: 'moist', s: 'Lembap', l: 'Kelembapan', u: '%', d: 1 },\n      ], tick: Date.now() } },\n  computed: {\n    d() { return this.msg?.payload || null },\n    skew() { return 0 },\n  },\n  mounted() { this.timer = setInterval(() => { this.tick = Date.now() }, 1000) },\n  unmounted() { clearInterval(this.timer) },\n  methods: {\n\n    fmt(v, d) { return v === null || v === undefined || isNaN(Number(v)) ? '\u2013' : Number(v).toFixed(d) },\n    wib(t) {\n      if (!t) return '\u2013'\n      return new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Jakarta', day: '2-digit', month: 'short', year: 'numeric',\n        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date(t)) + ' WIB'\n    },\n    ago(t) {\n      if (!t) return 'belum pernah'\n      const s = Math.max(0, Math.round((this.tick + this.skew - new Date(t)) / 1000))\n      if (s < 60) return s + ' dtk lalu'\n      if (s < 3600) return Math.floor(s / 60) + ' mnt lalu'\n      if (s < 86400) return Math.floor(s / 3600) + ' jam lalu'\n      return Math.floor(s / 86400) + ' hari lalu'\n    },\n\n  },\n}\n</script>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 1060,
    "y": 340,
    "wires": [
      []
    ]
  },
  {
    "id": "dash_raw",
    "type": "ui-template",
    "z": "dash_tab",
    "group": "dash_g_raw",
    "page": "",
    "ui": "",
    "name": "raw ADC",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div style=\"width: 100%\">\n    <v-expansion-panels>\n      <v-expansion-panel>\n        <v-expansion-panel-title>Raw ADC (untuk kalibrasi)</v-expansion-panel-title>\n        <v-expansion-panel-text>\n          <table class=\"agri-table\">\n            <thead><tr><th>Kanal</th><th>Terakhir</th><th>Min</th><th>Rata-rata</th><th>Max</th></tr></thead>\n            <tbody>\n              <tr v-for=\"c in channels\" :key=\"c.k\">\n                <td>{{ c.l }}</td>\n                <td>{{ show(latest[c.k]) }} <small>counts</small></td>\n                <td>{{ show(stats[c.k]?.min) }}</td>\n                <td>{{ show(stats[c.k]?.avg) }}</td>\n                <td>{{ show(stats[c.k]?.max) }}</td>\n              </tr>\n            </tbody>\n          </table>\n          <div class=\"agri-note\">Min / rata-rata / max selama rentang {{ msg?.range || '\u2013' }} (dari rata-rata per bucket).</div>\n        </v-expansion-panel-text>\n      </v-expansion-panel>\n    </v-expansion-panels>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return { channels: [\n      { k: 'npk1_raw', l: 'NPK 1' }, { k: 'npk2_raw', l: 'NPK 2' },\n      { k: 'moist_raw', l: 'Moisture' }, { k: 'ph_raw', l: 'pH' },\n    ] }\n  },\n  computed: {\n    latest() { return this.msg?.payload?.latest || {} },\n    stats() { return this.msg?.payload?.stats || {} },\n  },\n  methods: { show(v) { return v === null || v === undefined ? '\u2013' : Math.round(v) } },\n}\n</script>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 1060,
    "y": 620,
    "wires": [
      []
    ]
  },
