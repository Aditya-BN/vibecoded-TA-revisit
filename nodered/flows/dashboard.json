  {
    "id": "dash_ov_pg",
    "type": "postgresql",
    "z": "dash_tab",
    "name": "all devices + latest reading",
    "query": "SELECT d.id, COALESCE(NULLIF(d.name, ''), d.id) AS name, d.first_seen, d.last_seen, d.last_lat, d.last_lng,\n       r.ts, r.n, r.p, r.k, r.ph, r.moist, r.npk1_raw, r.npk2_raw, r.moist_raw, r.ph_raw, r.in_soil,\n       (now() - d.last_seen) < make_interval(secs => $1::int) AS online, now() AS server_now\nFROM devices d\nLEFT JOIN LATERAL (SELECT * FROM readings WHERE device_id = d.id ORDER BY ts DESC LIMIT 1) r ON true ORDER BY d.id",
    "postgreSQLConfig": "ingest_pgconf",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 560,
    "y": 100,
    "wires": [
      [
        "dash_ov_fn"
      ]
    ]
  },
  {
    "id": "dash_ov_fn",
    "type": "function",
    "z": "dash_tab",
    "name": "cards, map, dropdown options",
    "func": "// Same data for every viewer: cards + map (no msg._client, so everyone gets it and\n// late joiners get the stored copy). The dropdown options are only re-sent when the\n// list of sensors changes, so nobody's selection is disturbed every 10 s.\nconst rows = Array.isArray(msg.payload) ? msg.payload : [];\nconst now = rows.length ? rows[0].server_now : new Date();\nconst devices = rows.map(({ server_now, ...d }) => d);\nconst ids = devices.map(d => d.id);\nflow.set('deviceIds', ids);\n\nconst view = { payload: devices, now, sentAt: Date.now() };\nlet options = null;\nconst sig = JSON.stringify(devices.map(d => [d.id, d.name]));\nif (sig !== flow.get('optionsSig')) {\n    flow.set('optionsSig', sig);\n    options = { ui_update: { options: devices.map(d => ({ label: d.name === d.id ? d.id : d.name + ' (' + d.id + ')', value: d.id })) } };\n}\nreturn [view, { ...view }, options];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 100,
    "wires": [
      [
        "dash_cards"
      ],
      [
        "dash_map"
      ],
      [
        "dash_dropdown"
      ]
    ]
  },
  {
    "id": "dash_cards",
    "type": "ui-template",
    "z": "dash_tab",
    "group": "dash_g_cards",
    "page": "",
    "ui": "",
    "name": "sensor cards",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div style=\"width: 100%\">\n    <div class=\"agri-grid\">\n      <div v-if=\"!devices.length\" class=\"agri-empty\">Belum ada sensor. Sensor baru muncul otomatis setelah kirim data pertama ke <code>agrisoil/&lt;DEVICE_ID&gt;/reading</code>.</div>\n      <a v-for=\"d in devices\" :key=\"d.id\" class=\"agri-card\" :class=\"{ off: !d.online }\" :href=\"link(d.id)\">\n        <div class=\"agri-head\">\n          <b>{{ d.name }}</b><span v-if=\"d.name !== d.id\" class=\"agri-id\">{{ d.id }}</span>\n          <span class=\"agri-pill\" :class=\"d.online ? 'on' : 'offl'\">\u25cf {{ d.online ? 'online' : 'offline' }}</span>\n          <span v-if=\"d.in_soil === false\" class=\"agri-pill warn\">tidak di tanah</span>\n        </div>\n        <div class=\"agri-vals\">\n          <div v-for=\"f in fields\" :key=\"f.k\" class=\"agri-v\" :title=\"f.l\">\n            <div class=\"l\">{{ f.s }}</div><div class=\"n\">{{ fmt(d[f.k], f.d) }}</div><small>{{ f.u }}</small>\n          </div>\n        </div>\n        <div class=\"agri-foot\"><span :title=\"wib(d.last_seen)\">Terakhir: {{ ago(d.last_seen) }}</span><span>{{ wib(d.ts) }}</span></div>\n      </a>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() { return { fields: [\n        { k: 'n', s: 'N', l: 'Nitrogen (N)', u: 'ppm', d: 1 },\n        { k: 'p', s: 'P', l: 'Fosfor (P)', u: 'ppm', d: 1 },\n        { k: 'k', s: 'K', l: 'Kalium (K)', u: 'ppm', d: 1 },\n        { k: 'ph', s: 'pH', l: 'pH tanah', u: 'pH', d: 2 },\n        { k: 'moist', s: 'Lembap', l: 'Kelembapan', u: '%', d: 1 },\n      ], tick: Date.now() } },\n  computed: {\n    devices() { return Array.isArray(this.msg?.payload) ? this.msg.payload : [] },\n    // server time minus the time it was sent, so \"x ago\" is right even if the viewer's clock is off\n    skew() { return this.msg?.now && this.msg?.sentAt ? new Date(this.msg.now) - this.msg.sentAt : 0 },\n  },\n  mounted() { this.timer = setInterval(() => { this.tick = Date.now() }, 1000) },\n  unmounted() { clearInterval(this.timer) },\n  methods: {\n\n    fmt(v, d) { return v === null || v === undefined || isNaN(Number(v)) ? '\u2013' : Number(v).toFixed(d) },\n    wib(t) {\n      if (!t) return '\u2013'\n      return new Intl.DateTimeFormat('id-ID', { timeZone: 'Asia/Jakarta', day: '2-digit', month: 'short', year: 'numeric',\n        hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).format(new Date(t)) + ' WIB'\n    },\n    ago(t) {\n      if (!t) return 'belum pernah'\n      const s = Math.max(0, Math.round((this.tick + this.skew - new Date(t)) / 1000))\n      if (s < 60) return s + ' dtk lalu'\n      if (s < 3600) return Math.floor(s / 60) + ' mnt lalu'\n      if (s < 86400) return Math.floor(s / 3600) + ' jam lalu'\n      return Math.floor(s / 86400) + ' hari lalu'\n    },\n\n    link(id) { return 'sensor?device=' + encodeURIComponent(id) },\n  },\n}\n</script>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 1060,
    "y": 60,
    "wires": [
      []
    ]
  },
  {
    "id": "dash_map",
    "type": "ui-template",
    "z": "dash_tab",
    "group": "dash_g_map",
    "page": "",
    "ui": "",
    "name": "map (Leaflet)",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div style=\"width: 100%\">\n    <div ref=\"map\" style=\"height: 420px; border-radius: 12px; background: #e9ece6\"></div>\n    <div v-if=\"!hasPoints\" class=\"agri-note\">Belum ada lokasi GPS.</div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() { return { hasPoints: false } },\n  watch: { msg: function () { this.draw() } },\n  mounted() {\n    // Dashboard 2.0 has no map widget: Leaflet (served by Node-RED at /vendor/leaflet/) in a ui-template.\n    this.loadLeaflet().then((L) => {\n      this.map = L.map(this.$refs.map, { scrollWheelZoom: false }).setView([-6.2, 106.8166], 13)\n      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap contributors' }).addTo(this.map)\n      this.markers = {}\n      this.draw()\n    })\n  },\n  unmounted() { if (this.map) this.map.remove() },\n  methods: {\n    loadLeaflet() {\n  if (window.L) return Promise.resolve(window.L)\n  if (!window.__agriLeaflet) {\n    window.__agriLeaflet = new Promise((resolve, reject) => {\n      const css = document.createElement('link')\n      css.rel = 'stylesheet'; css.href = '/vendor/leaflet/leaflet.css'\n      document.head.appendChild(css)\n      const js = document.createElement('script')\n      js.src = '/vendor/leaflet/leaflet.js'\n      js.onload = () => resolve(window.L); js.onerror = reject\n      document.head.appendChild(js)\n    })\n  }\n  return window.__agriLeaflet\n    },\n    esc(s) { return String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c])) },\n    draw() {\n      if (!this.map) return\n      const L = window.L\n      const devices = Array.isArray(this.msg?.payload) ? this.msg.payload : []\n      const pts = []\n      let added = false\n      for (const d of devices) {\n        if (d.last_lat === null || d.last_lng === null) continue\n        const ll = [d.last_lat, d.last_lng]\n        pts.push(ll)\n        const html = '<b><a href=\"sensor?device=' + encodeURIComponent(d.id) + '\">' + this.esc(d.name) + '</a></b><br>' +\n          (d.online ? 'online' : 'offline') + '<br>N ' + (d.n ?? '\u2013') + ' \u00b7 P ' + (d.p ?? '\u2013') + ' \u00b7 K ' + (d.k ?? '\u2013') + ' ppm<br>' +\n          'pH ' + (d.ph ?? '\u2013') + ' \u00b7 ' + (d.moist ?? '\u2013') + ' %'\n        if (!this.markers[d.id]) {\n          this.markers[d.id] = L.marker(ll, { title: d.name }).addTo(this.map)\n            .bindTooltip(this.esc(d.name), { permanent: true, direction: 'top', offset: [-15, -12] }).bindPopup(html)\n          added = true\n        } else {\n          this.markers[d.id].setLatLng(ll).setPopupContent(html)\n        }\n      }\n      this.hasPoints = pts.length > 0\n      // fit once, and again whenever a new sensor appears\n      if (pts.length && (added || !this.fitted)) {\n        this.map.invalidateSize()\n        this.map.fitBounds(pts, { paddingTopLeft: [40, 70], paddingBottomRight: [40, 30], maxZoom: 16 })\n        this.fitted = true\n      }\n    },\n  },\n}\n</script>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 1060,
    "y": 100,
    "wires": [
      []
    ]
  },
