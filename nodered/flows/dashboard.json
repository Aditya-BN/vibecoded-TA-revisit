  {
    "id": "dash_state",
    "type": "function",
    "z": "dash_tab",
    "name": "per-viewer state",
    "func": "// Remembers, per browser tab (socket id), which sensor and range it is looking at,\n// so one viewer's choice never changes another viewer's screen (client constraints).\n// Inputs: ui-event ($pageview/$pageleave), dropdown (topic \"device\"), range buttons (topic \"range\"), tick.\n// Outputs: 1 = load data for one client, 2 = set that client's dropdown, 3 = set that client's range buttons.\nconst clients = flow.get('clients') || {};\nconst devices = flow.get('deviceIds') || [];\nconst now = Date.now();\nconst out1 = [], out2 = [], out3 = [];\n\nfunction client(msg) { return msg._client && msg._client.socketId; }\nfunction load(id) {\n    const c = clients[id];\n    if (!c.device) return;\n    out1.push({ _client: c.client, device: c.device, range: c.range });\n}\n\nif (msg.topic === 'tick') {\n    for (const [id, c] of Object.entries(clients)) {\n        if (now - c.seen > 6 * 3600 * 1000) delete clients[id]; // tab long gone\n        else load(id);\n    }\n} else if (msg.topic === '$pageview' || msg.topic === '$pageleave') {\n    const id = client(msg);\n    const page = msg.payload && msg.payload.page;\n    const onSensor = page && page.path === '/sensor';\n    if (!id) return null;\n    if (msg.topic === '$pageleave' || !onSensor) {\n        if (msg.topic === '$pageleave' && onSensor) delete clients[id];\n    } else {\n        const q = (msg.payload.query) || {};\n        const c = clients[id] || { range: '24h' };\n        c.client = msg._client;\n        c.seen = now;\n        if (q.device && /^[A-Za-z0-9_]{1,64}$/.test(q.device)) c.device = q.device;\n        if (!c.device) c.device = devices[0];\n        clients[id] = c;\n        if (c.device) out2.push({ payload: c.device, _client: c.client });\n        out3.push({ payload: c.range, _client: c.client });\n        load(id);\n    }\n} else if (msg.topic === 'device' || msg.topic === 'range') {\n    const id = client(msg);\n    if (!id) return null;\n    const c = clients[id] || { range: '24h' };\n    c.client = msg._client;\n    c.seen = now;\n    if (msg.topic === 'device' && typeof msg.payload === 'string' && msg.payload) c.device = msg.payload;\n    if (msg.topic === 'range' && ['1h', '24h', '7d'].includes(msg.payload)) c.range = msg.payload;\n    clients[id] = c;\n    load(id);\n}\n\nflow.set('clients', clients);\nreturn [out1, out2, out3];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 240,
    "wires": [
      [
        "dash_lt_params"
      ],
      [
        "dash_dropdown"
      ],
      [
        "dash_range"
      ]
    ]
  },
  {
    "id": "dash_lt_params",
    "type": "function",
    "z": "dash_tab",
    "name": "params",
    "func": "msg.params = [Number(env.get('OFFLINE_AFTER_SECONDS') || 120), msg.device];\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
